---
import Badge from '../components/Badge.astro';
import UiIcon from '../components/UiIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';

const journey = [
  ['01', 'Describe Your Place', 'Add properties, rooms and capacities', 'Set rates, taxes and booking sources', 'Define services, products and equipment', 'Invite staff into the right roles'],
  ['02', 'Take the Booking', 'Quote from configured prices', 'Choose rooms for a whole or split stay', 'Record the group, charges and notes', 'Check availability again on save'],
  ['03', 'Run the Stay', 'Assign guides and gear to purchased activities', 'See arrivals, tasks and housekeeping', 'Send booking-linked sales to kitchen', 'Keep each team on the same plan'],
  ['04', 'Close the Books', 'Record and allocate manual payments', 'Attach scanned receipt evidence', 'Print the booking invoice', 'Review currency-specific reports'],
] as const;

const teamViews = [
  ['Front desk', 'Bookings and guests', 'A stay’s rooms, charges, group and messages in one record.', '/product/booking.webp'],
  ['Operations', 'Crew and assets', 'Schedule guides, horses, boats and vehicles for concrete times.', '/product/calendar-crew.webp'],
  ['Kitchen', 'Tickets and meals', 'Prepare booking-linked orders and see dietary context.', '/product/kitchen.webp'],
  ['Housekeeping', 'Rooms and tasks', 'See what needs turning, cleaning and inspection.', '/product/operations.webp'],
  ['Finance', 'Payments and reports', 'Follow charges, balances, receipts and exports.', '/product/reports.webp'],
] as const;
---

<BaseLayout title="About Malvavisco — Makers of LodgeOps" description="Malvavisco makes LodgeOps, administration software shaped around the work of running a lodge.">
  <PageHero
    pageClass="about-hero"
    compact
    breadcrumb="About Malvavisco"
    title="A Calmer Way to Run Your Lodge"
    description="Malvavisco makes LodgeOps so the people who run a lodge can keep bookings, guides, kitchen work and the books together, then get back to their guests."
  />

  <section class="about-story section-pad">
    <div class="shell story-grid">
      <div class="story-media">
        <img src="/product/dashboard.webp" alt="LodgeOps dashboard filled with fictional sample lodge data" loading="lazy" />
        <div class="story-stats"><div><strong data-count-value="11">11</strong><span>Staff Roles</span></div><div><strong data-count-value="2">2</strong><span>Staff Languages</span></div><div><strong data-count-value="3">3</strong><span>Calendar Views</span></div></div>
      </div>
      <div class="story-copy">
        <Badge label="Why We Exist" />
        <h2>Hospitality Happens Away from the Keyboard</h2>
        <p>A lodge day rarely follows a neat itinerary. A new arrival changes rooms, a guide needs a boat, lunch goes on the right booking and someone needs the latest balance. LodgeOps puts those connected tasks in one workspace.</p>
        <p>We build around the routines of front desk, operations, kitchen, housekeeping and finance teams. The goal is straightforward software with a clear record of what happened.</p>
        <h3>Our House Rules</h3>
        <ul class="story-values">
          <li><span>✓</span>Calm is a feature: make the next action clear when the day gets busy.</li>
          <li><span>✓</span>Keep the work together: rooms, activities, meals and money belong to the same stay.</li>
          <li><span>✓</span>Give straight answers about what LodgeOps does today and what still needs work.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="journey-section section-pad">
    <div class="journey-panel shell" data-carousel>
      <div class="journey-head">
        <div><Badge label="One Connected Stay" /><h2>From First Inquiry to Final Bill</h2></div>
        <p>These are the steps LodgeOps joins up for a lodge team. Drag the cards or use the arrow keys to explore.</p>
      </div>
      <div class="journey-carousel">
        <div class="journey-track" data-carousel-track tabindex="0" role="region" aria-roledescription="carousel" aria-label="LodgeOps workflow. Drag or use arrow keys to explore.">
          {journey.map(([number, title, ...points]) => (
            <article data-carousel-item aria-roledescription="slide"><h3>{number}</h3><p>{title}</p><ul>{points.map((point) => <li><span><UiIcon name="check" size={14} /></span>{point}</li>)}</ul></article>
          ))}
        </div>
        <fieldset class="carousel-controls" aria-label="Carousel pagination controls">
          <button class="carousel-button previous" type="button" data-carousel-button="previous" aria-label="Previous workflow item">
            <img src="/assets/framerusercontent.com/images/6tTbkXggWgQCAJ4DO2QEdXXmgM.svg" alt="" width="40" height="40" />
          </button>
          <button class="carousel-button next" type="button" data-carousel-button="next" aria-label="Next workflow item">
            <img src="/assets/framerusercontent.com/images/11KSGbIZoRSg4pjdnUoif6MKHI.svg" alt="" width="40" height="40" />
          </button>
        </fieldset>
      </div>
    </div>
  </section>

  <section class="team-section section-pad">
    <div class="shell">
      <SectionHeader eyebrow="For Every Team" title="The Same Stay, Seen from Each Role" description="These are real areas of the LodgeOps staff app, shown with fictional sample lodge data." />
      <div class="team-grid">
        {teamViews.map(([name, role, details, asset]) => (
          <article class="team-card" tabindex="0">
            <img src={asset} alt={`${name} view in LodgeOps`} loading="lazy" />
            <div class="team-card-content">
              <div class="team-card-details"><h3>{name}</h3><p>{role}</p><p class="team-detail">{details}</p></div>
            </div>
          </article>
        ))}
        <article class="join-card"><h3>Show us your week</h3><p>Bring your rooms, activities and the tricky parts of a typical day. We’ll walk through them in LodgeOps and talk about fit.</p><a class="button button-dark compact" href="/contact">Request a Demo <span class="button-arrow">→</span></a></article>
      </div>
    </div>
  </section>
</BaseLayout>
