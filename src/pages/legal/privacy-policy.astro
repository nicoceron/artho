---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LegalPage from "../../components/LegalPage.astro";

// Website notice only. Confirm the receiving endpoint, operator identity and
// retention practice before publishing. LodgeOps customer data needs its own
// service agreement and privacy documentation.
const sections = [
  {
    title: "What this notice covers",
    paragraphs: [
      "This notice describes the Malvavisco marketing website. Guest, staff and financial information entered in LodgeOps is handled under the separate agreement for each lodge.",
    ],
  },
  {
    title: "Browsing this website",
    paragraphs: [
      "The website's own code does not load analytics scripts or advertising pixels, and does not set tracking cookies. Its product screenshots, fonts, styles and motion are served as site assets.",
      "The hosting infrastructure receives ordinary request information, such as your IP address, the requested page and browser details, to deliver the site. The host's actual log retention must be confirmed before release.",
    ],
  },
  {
    title: "Requesting a demo",
    paragraphs: [
      "The request form asks for your name, email and lodge name. Country, property size and a message are optional. These details are intended to help us respond and prepare a relevant walkthrough.",
      "When a request endpoint is configured, the site sends those details to it. When only an email address is configured, your email app opens a draft for you to review and send. If neither is configured, the form cannot submit.",
      "The receiving service and retention period for submitted requests must be confirmed before public use.",
    ],
  },
  {
    title: "Questions",
    paragraphs: [
      "Use the Request a Demo page to ask about information you have sent through this website. If the form is unavailable, wait until a contact channel is published.",
    ],
  },
];
---

<BaseLayout title="Website Privacy — Malvavisco" description="Draft notice describing the data flows of the Malvavisco marketing website." noIndex>
  <LegalPage title="Website Privacy" updated="October 3, 2026" updatedISO="2026-10-03" reviewNote="Draft for review — confirm the site operator, demo request recipient and log and request retention before public release." sections={sections} />
</BaseLayout>
