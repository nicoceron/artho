---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LegalPage from "../../components/LegalPage.astro";

// Website-only draft. Do not substitute this page for a signed LodgeOps
// service agreement or publish without confirming the contracting entity.
const sections = [
  {
    title: "Website scope",
    paragraphs: [
      "These draft terms describe the Malvavisco marketing website. Access to and use of LodgeOps by a lodge and its staff are governed by a separate service agreement.",
      "The website lets visitors explore product information and request a conversation. It does not sell a subscription or open a LodgeOps account by itself.",
    ],
  },
  {
    title: "Product information",
    paragraphs: [
      "The pages describe current product workflows and known limits as general information. Configuration, operating environment and service terms are discussed with each lodge before any agreement.",
      "Screenshots come from the real LodgeOps staff interface populated with a fictional sample lodge. Names, bookings and amounts shown in them are examples, not customer stories or performance results.",
    ],
  },
  {
    title: "Website materials",
    paragraphs: [
      "The names, text, illustrations and screenshots on this site are presented for learning about Malvavisco and LodgeOps. Ask before republishing or presenting them as your own.",
    ],
  },
  {
    title: "Other websites",
    paragraphs: [
      "If this site links to another website, that website has its own content and terms. Review them before using it.",
    ],
  },
  {
    title: "Questions",
    paragraphs: [
      "Use the Request a Demo page for questions about the website or the product. The legal identity and final service terms must be confirmed separately.",
    ],
  },
];
---

<BaseLayout title="Website Terms — Malvavisco" description="Draft terms for the Malvavisco marketing website, separate from LodgeOps service agreements." noIndex>
  <LegalPage title="Website Terms" updated="October 3, 2026" updatedISO="2026-10-03" reviewNote="Draft for review — confirm the contracting entity and approve final website and service terms before public release." sections={sections} />
</BaseLayout>
