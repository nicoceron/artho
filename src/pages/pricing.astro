---
import BaseLayout from "../layouts/BaseLayout.astro";
import LogoRail from "../components/LogoRail.astro";
import SectionHeader from "../components/SectionHeader.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Testimonials from "../components/Testimonials.astro";
import UiIcon from '../components/UiIcon.astro';

const steps = [
  { name: "Tell Us About Your Lodge", number: "01", description: "We start with your property and the work your team does every day.", tone: "gray", features: ["Rooms, cabins and locations", "Rates, services and products", "Guides, gear and kitchen", "Current booking and payment process", "The questions you want answered"] },
  { name: "See a Real Workflow", number: "02", description: "We walk through LodgeOps using a sample lodge and your practical scenarios.", tone: "mint", features: ["Quote and save a stay", "Check room and crew availability", "Run an activity and kitchen order", "Record a payment and print an invoice", "Review reporting and roles"] },
  { name: "Discuss the Fit", number: "03", description: "If the product fits, we can discuss configuration, rollout and commercial terms.", tone: "blue", features: ["What your team needs configured", "What works today", "What remains outside the product", "Training and support expectations", "A scope-based commercial conversation"] },
] as const;

const tourAreas = [
  ["Bookings & Calendar", "Rooms and split stays, capacity checks, Places, Crew and Assets views.", "calendar"],
  ["Activities & Operations", "Purchased services become scheduled work with concrete guides and gear.", "team"],
  ["Kitchen & Point of Sale", "Booking-linked charges become preparation tickets where needed.", "integrations"],
  ["Payments & Reports", "Manual receipts, printable invoices and currency-specific reporting.", "analytics"],
  ["Team & Guest Messages", "Eleven staff roles, bilingual templates and configurable reminders.", "shield"],
] as const;

const questions = [
  ["Is there a published subscription price or free trial?", "No public subscription tiers or self-service trial have been set for Malvavisco. We discuss commercial terms after seeing what your lodge needs."],
  ["Can we use LodgeOps across more than one lodge?", "The system supports separate workspaces and properties. A person who belongs to several workspaces can switch between them."],
  ["Do guests pay online through LodgeOps?", "Staff can record cash, bank-transfer and card-terminal payments. Mercado Pago links for Argentina and ARS are built, but real provider checkout and settlement have not been accepted for production use."],
  ["Does LodgeOps connect to Booking.com or Airbnb?", "No. LodgeOps is not a channel manager. It can publish iCal availability feeds for external calendars."],
  ["How long does setup take?", "It depends on your properties, room inventory, rates, activities, team and guest communications. We will review that scope with you rather than promise a fixed setup time."],
  ["Can we see what is not in the product yet?", "Yes. We cover limits during the walkthrough, including online checkout, OTA connections, fiscal integration, package pricing and offline operation."],
] as const;
---

<BaseLayout title="For Lodges — LodgeOps by Malvavisco" description="See how LodgeOps could fit your lodge, then discuss setup and commercial terms with Malvavisco.">
  <section class="pricing-hero section-pad">
    <div class="shell">
      <p class="breadcrumb centered"><a href="/">Home</a><span>/</span>For Lodges</p>
      <SectionHeader level="h1" title="See How LodgeOps Fits Your Lodge" description="Tell us how your property runs. We’ll show you the product against your real workflow and discuss scope and commercial terms if it is a fit." />
      <div class="pricing-grid">
        {steps.map((step) => (
          <article class:list={["pricing-card", step.tone]}>
            <h3>{step.name}</h3>
            <div class="price"><strong>{step.number}</strong></div>
            <p>{step.description}</p>
            <h4>We cover:</h4>
            <ul>{step.features.map((feature) => <li><span>✓</span>{feature}</li>)}</ul>
            <a class="button button-dark" href="/contact">Request a Demo</a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <LogoRail />
  <section class="addons-section section-pad">
    <div class="shell">
      <SectionHeader eyebrow="Product Walkthrough" title="Follow the Work from Booking to Checkout" description="The demo uses real areas of the LodgeOps staff app with fictional sample lodge data." />
      <div class="addon-list">
        {tourAreas.map(([title, description, icon], index) => (
          <article class="addon-card"><div class="addon-intro"><span class="addon-icon"><UiIcon name={icon} size={20} /></span><div><h3>{title}</h3><p>{description}</p></div></div><div class="addon-price"><strong>{String(index + 1).padStart(2, '0')}</strong></div><a class="button button-outline compact" href="/contact">See in Demo</a></article>
        ))}
      </div>
    </div>
  </section>
  <section class="pricing-faq section-pad">
    <div class="shell faq-shell">
      <SectionHeader eyebrow="Practical Questions" title="What to Know Before We Talk" />
      <FaqAccordion items={questions} />
    </div>
  </section>
  <Testimonials />
</BaseLayout>

<style>
  .addon-price strong { font-size: 20px; }
</style>
