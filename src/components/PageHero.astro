---
import Button from "./Button.astro";
import CheckList from "./CheckList.astro";
import { malvaviscoBrand } from "../data/malvavisco";

interface Props {
  breadcrumb: string;
  title: string;
  description: string;
  images?: readonly string[];
  compact?: boolean;
  pageClass?: string;
  reveal?: boolean;
}

const { breadcrumb, title, description, images = [], compact = false, pageClass, reveal = false } = Astro.props;
---

<section class:list={["page-hero", pageClass, { compact, "with-images": images.length }]}>
  <div class="shell page-hero-inner">
    <div class="page-hero-copy" data-reveal={reveal ? "" : undefined}>
      <p class="breadcrumb"><a href="/">Home</a><span>/</span>{breadcrumb}</p>
      <h1>{title}</h1>
      <p class="page-hero-description">{description}</p>
      {!compact && (
        <>
          <div class="button-row">
            <Button href="/contact">Request a demo <span class="button-arrow">→</span></Button>
            <Button href="/features" variant="outline">Explore the product</Button>
          </div>
          <CheckList items={[...malvaviscoBrand.highlights]} compact />
        </>
      )}
    </div>
    {images.length > 0 && (
      <div class="page-hero-collage" data-reveal={reveal ? "" : undefined}>
        {images.map((src) => <img src={src} alt="Malvavisco product and lodge operations preview" />)}
      </div>
    )}
  </div>
</section>
