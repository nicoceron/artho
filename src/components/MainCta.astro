---
import Badge from './Badge.astro';
import UiIcon from './UiIcon.astro';
import Button from './Button.astro';
import CheckList from './CheckList.astro';
---

<section class="main-cta section-pad">
  <div class="main-cta-panel shell" data-reveal>
    <div class="main-cta-copy">
      <Badge label="See LodgeOps at Work" />
      <h2>Bring your busiest week. We’ll show you how it fits.</h2>
      <ul class="cta-benefits">
        <li><span aria-hidden="true"><UiIcon name="check" size={18} /></span><div><b>Start with your place</b><p>Walk through your rooms, rates, activities, and the people who run them.</p></div></li>
        <li><span aria-hidden="true"><UiIcon name="check" size={18} /></span><div><b>Follow a real stay</b><p>See a booking move through the calendar, guides and gear, kitchen, and bill.</p></div></li>
        <li><span aria-hidden="true"><UiIcon name="check" size={18} /></span><div><b>Get straight answers</b><p>We’ll show what LodgeOps does today and discuss what your operation needs.</p></div></li>
      </ul>
      <div class="button-row"><Button href="/contact">Request a Demo <span class="button-arrow">→</span></Button><Button href="/features" variant="outline">Explore the Product</Button></div>
      <CheckList items={["Built for lodge operations", "English and Spanish staff interface", "Configured for your property"]} compact />
    </div>
    <div class="main-cta-media"><img src="/product/dashboard.webp" alt="LodgeOps dashboard for a fictional sample lodge" loading="lazy" /></div>
  </div>
</section>
