---
import SectionHeader from "./SectionHeader.astro";
import UiIcon from './UiIcon.astro';
import { image, testimonials } from "../data/site";

const ratingAvatars = [
  image("K6cUNifhQFa6qEX3kqNwfqMkiY.jpg"),
  image("LMLNF0vU5ySMfVRIW3JtFu5iB78.jpg"),
  image("o5Afy3fkKnGfC4mJ0Y8DK0XqJDY.jpg"),
];
---

<section class="testimonials-section section-pad">
  <div class="shell">
    <div class="testimonial-header">
      <SectionHeader align="left" eyebrow="What Our Users Say" title="Trusted by Teams Who Value Simplicity and Results" />
      <div class="rating-summary">
        <p>See how our platform helps businesses save time, gain clarity, and grow with confidence.</p>
        <div><span class="rating-score"><span class="stars">{Array.from({ length:5 }).map(() => <UiIcon name="star" size={16} />)}</span><strong>4.7<small>/5.0</small></strong></span><span class="avatar-stack">{ratingAvatars.map((avatar) => <img src={avatar} alt="" />)}</span><strong class="customer-count">875+<small>Happy Customer</small></strong></div>
      </div>
    </div>
    <div class="testimonial-grid" data-motion-grid>
      <div class="testimonial-column">
      <article class="quote-card quote-one" data-reveal tabindex="0"><p>{testimonials[0].quote}</p><div class="person"><img src={testimonials[0].avatar} alt="" /><span><b>{testimonials[0].name}</b><small>{testimonials[0].role}</small></span></div></article>
      <div class="testimonial-pair">
      <article class="quote-card quote-two" data-reveal tabindex="0"><p>{testimonials[1].quote}</p><div class="person"><img src={testimonials[1].avatar} alt="" /><span><b>{testimonials[1].name}</b><small>{testimonials[1].role}</small></span></div></article>
      <article class="metric-card metric-seventy" data-reveal tabindex="0"><img src={image("BvopH4QwwVK2x02fTP4y8Nr4sm8.jpg")} alt="Financial reporting workspace" /><div class="metric-body"><strong data-count-value="70" data-count-suffix="%">70%</strong><h3>Less Time Spent on Manual Reporting</h3></div></article>
      </div>
      </div>
      <div class="testimonial-column">
      <div class="testimonial-pair">
      <article class="quote-card quote-three" data-reveal tabindex="0"><p>{testimonials[2].quote}</p><div class="person"><img src={testimonials[2].avatar} alt="" /><span><b>{testimonials[2].name}</b><small>{testimonials[2].role}</small></span></div></article>
      <article class="metric-card metric-satisfaction" data-reveal tabindex="0"><img src={image("myMtB6AwC3gKJpLrKk2cxSDGiEc.jpg")} alt="Customer satisfaction" /><div class="metric-body"><strong data-count-value="98" data-count-suffix="%">98%</strong><h3>User Satisfaction</h3><p>Highly rated for simplicity, speed, and financial clarity.</p></div></article>
      </div>
      <article class="quote-card quote-four" data-reveal tabindex="0"><p>{testimonials[3].quote}</p><div class="person"><img src={testimonials[3].avatar} alt="" /><span><b>{testimonials[3].name}</b><small>{testimonials[3].role}</small></span></div></article>
      </div>
    </div>
  </div>
</section>
