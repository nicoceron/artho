---
interface Props {
  article: {
    slug: string;
    title: string;
    category: string;
    date: string;
    dateISO: string;
    image: string;
    excerpt: string;
  };
}

const { article } = Astro.props;
---

<article class="blog-card" data-blog-card>
  <a class="blog-card-image" href={`/blog/${article.slug}`} tabindex="-1" aria-label={`Read ${article.title}`}>
    <img src={article.image} width="1760" height="1100" loading="lazy" decoding="async" alt="" />
  </a>
  <div class="blog-card-details"><div class="blog-card-meta"><span>{article.category}</span><time datetime={article.dateISO}>{article.date}</time></div>
  <h2><a href={`/blog/${article.slug}`}>{article.title}</a></h2>
  <p>{article.excerpt}</p>
  </div>
</article>

<style>
  .blog-card-image {
    aspect-ratio: 16 / 10;
    background: #edf1f4;
  }
  .blog-card-image img {
    object-fit: contain;
  }
  .blog-card h2,
  .blog-card-details > p {
    height: auto;
    overflow: visible;
  }
</style>
