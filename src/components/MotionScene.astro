---
import { productScreenshots } from "../data/malvavisco";

interface Props {
  scene: "simple" | "accuracy" | "security" | "overview" | "billing" | "analytics" | "budget" | "integrations";
  context?: 'feature' | 'workflow';
}

const { scene, context = 'feature' } = Astro.props;

const overviewFrames = [
  productScreenshots.calendar,
  productScreenshots.crew,
  productScreenshots.assets,
];
const billingFrames = [
  productScreenshots.booking,
  productScreenshots.activities,
  productScreenshots.pos,
  productScreenshots.kitchen,
];
const accuracyFrames = [
  productScreenshots.activities,
  productScreenshots.crew,
  productScreenshots.assets,
  productScreenshots.calendar,
];
const budgetFrames = [
  productScreenshots.activities,
  productScreenshots.crew,
  productScreenshots.assets,
];
const integrationMarks = [
  { name: "Bookings", mark: "B" },
  { name: "Rooms", mark: "R" },
  { name: "Guides", mark: "G" },
  { name: "Gear", mark: "A" },
  { name: "Kitchen", mark: "K" },
  { name: "Sales", mark: "S" },
  { name: "Reports", mark: "↗" },
  { name: "Team", mark: "T" },
];

const frameDelays: Record<Props["scene"], string> = {
  simple: "500,500",
  accuracy: "500,500,500",
  security: "500,500,500,500,800,800,500,500",
  overview: "500,500",
  billing: "500,500,500,500,500",
  analytics: "800,800,500",
  budget: "500,500,1000,500,500,500",
  integrations: "500,500",
};

// Keep the source scene IDs for motion timing, but describe the current product
// subject to people who focus an animated preview.
const sceneDescriptions: Record<Props["scene"], string> = {
  simple: "Daily operations preview for a sample lodge",
  accuracy: "Guide and equipment scheduling preview for a sample lodge",
  security: "Staff roles and access preview for a sample lodge",
  overview: "Places, Crew and Assets calendar preview for a sample lodge",
  billing: "Booking, point of sale and kitchen preview for a sample lodge",
  analytics: "Arrivals and daily work preview for a sample lodge",
  budget: "Activity, guide and equipment planning preview for a sample lodge",
  integrations: "Connected booking, kitchen and reporting preview for a sample lodge",
};
---

<div
  class:list={["motion-scene", `motion-scene-${scene}`]}
  data-motion-sequence={context === 'feature' ? true : undefined}
  data-workflow-analytics={context === 'workflow' ? true : undefined}
  data-workflow-step={context === 'workflow' ? '0' : undefined}
  data-motion-name={scene}
  data-motion-delays={context === 'workflow' ? '1000,1000,1000,1000,1000,1000' : frameDelays[scene]}
  data-motion-step="0"
  tabindex="0"
  role="group"
  aria-label={sceneDescriptions[scene]}
>
  {scene === "simple" && (
    <img class="scene-dashboard scene-dashboard-main" src={productScreenshots.mobileOperations.src} alt="" aria-hidden="true" />
  )}

  {scene === "accuracy" && (
    <div class="accuracy-stage" aria-hidden="true">
      <div class="accuracy-track">
        {accuracyFrames.map((screen) => <img src={screen.src} alt={screen.alt} />)}
      </div>
    </div>
  )}

  {scene === "security" && (
    <div class="security-stage" aria-hidden="true">
      <div class="security-grid" aria-hidden="true"></div>
      <div class="security-settings"><span class="security-settings-kicker">Team access</span><h4>Give each role a clear view</h4><div><span>Reception</span><b>Bookings · Guests</b></div><div><span>Guides</span><b>Activities · Crew</b></div><div><span>Kitchen</span><b>Orders · Dietary notes</b></div><small>Sample workspace roles</small></div>
      <div class="security-rail" aria-hidden="true">
        <span class="security-person">M</span>
        <span class="security-lock">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 10V7.5a4.5 4.5 0 0 1 8.55-1.95M6 10h12v10H6zM12 14v2.5" /></svg>
        </span>
        <img class="security-user-badge" src="/favicon.svg" alt="" />
      </div>
      <div class="security-login" aria-hidden="true">
        <div class="security-login-head">
          <img src="/favicon.svg" alt="" />
          <div><b>Sign in to the staff workspace</b><span>Your role determines the tools you see.</span></div>
        </div>
        <i class="security-divider"></i>
        <div class="security-fields">
          <label>Email Address* <span class="security-input security-email"><i>✉</i><em>staff@example.com</em></span></label>
          <label>Password* <span class="security-input security-password"><i>♙</i><em>••••••••••</em></span></label>
        </div>
        <div class="security-action"><span><i>✓</i> Two-factor sign-in</span><u>Activity log</u></div>
        <button class="security-submit" type="button" tabindex="-1">Continue</button>
      </div>
    </div>
  )}

  {scene === "overview" && (
    <div class="overview-stage" aria-hidden="true">
        {overviewFrames.map((screen, index) => <img src={screen.src} alt={screen.alt} data-motion-frame={index} />)}
    </div>
  )}

  {scene === "billing" && (
    <div class="billing-stage" aria-hidden="true">
      <div class="billing-list">
          {billingFrames.slice(1).map((screen, index) => <img src={screen.src} alt={screen.alt} data-motion-frame={index} />)}
      </div>
      <img class="billing-my-cards" src={billingFrames[0].src} alt={billingFrames[0].alt} />
    </div>
  )}

  {scene === "analytics" && (
    <div class="analytics-stage" aria-hidden="true">
      <div class="analytics-stack">
        <div class="analytics-score-card">
          <div class="analytics-card-head">
            <span class="analytics-head-title">
              <svg viewBox="0 0 18 15" aria-hidden="true"><path d="M1 12.5a8 8 0 1 1 16 0M9 10l3.8-4" /><circle cx="9" cy="10" r="1" /></svg>
              Arrivals today
            </span>
            <span class="analytics-head-button">Details</span>
          </div>
          <i class="analytics-divider"></i>
          <div class="analytics-score-details">
            <div>
              <span>In this sample lodge <b><i class="score-zero">0</i><i class="score-value">2</i></b></span>
              <small>See arrivals alongside today’s tasks.</small>
            </div>
            <span class="analytics-score-icon" aria-hidden="true">↗</span>
          </div>
          <div class="score-bars">{Array.from({ length: 36 }).map((_, index) => <i class:list={{ muted: index >= 26 }}></i>)}</div>
        </div>
        <div class="analytics-expense-card">
          <div class="analytics-card-head">
            <span class="analytics-head-title">
              <svg viewBox="0 0 17 15" aria-hidden="true"><path d="M1 1h15v13H1zM4 10V7m4 3V4m4 6V6" /></svg>
              Today’s work
            </span>
            <span class="analytics-head-button analytics-weekly">Weekly <svg viewBox="0 0 8 5" aria-hidden="true"><path d="m1 1 3 3 3-3" /></svg></span>
          </div>
          <i class="analytics-divider"></i>
          <div class="analytics-chart">
            <div class="analytics-y-axis"><span>Rooms</span><span>Guides</span><span>Kitchen</span></div>
            <div class="analytics-plot">
              <div class="analytics-grid" aria-hidden="true">{Array.from({ length: 6 }).map(() => <i></i>)}</div>
              <div class="analytics-bars" aria-hidden="true"><i></i><i></i><i></i></div>
              <div class="analytics-x-axis"><span>0</span><span>2</span><span>4</span><span>6</span><span>8</span><span>10</span></div>
            </div>
          </div>
        </div>
        <img class="analytics-balance-card" src={productScreenshots.operations.src} alt={productScreenshots.operations.alt} />
      </div>
    </div>
  )}

  {scene === "budget" && (
    <div class="budget-stage" aria-hidden="true">
      {budgetFrames.map((screen, index) => <img src={screen.src} alt={screen.alt} data-motion-frame={index} />)}
    </div>
  )}

  {scene === "integrations" && (
    <div class="integration-stage" aria-hidden="true">
      <div class="integration-group">
        <div class="integration-center"><img src="/favicon.svg" alt="Malvavisco" /></div>
        <svg class="integration-swap" viewBox="0 0 32 32" aria-hidden="true">
          <path d="M7 11h18m-4-4 4 4-4 4M25 21H7m4 4-4-4 4-4" />
        </svg>
        <div class="integration-orbit">
          {integrationMarks.map((module) => <span aria-label={module.name} title={module.name}>{module.mark}</span>)}
        </div>
      </div>
    </div>
  )}
</div>
