---
import articles from "../data/articles.json";
import BlogCard from "./BlogCard.astro";

type Article = (typeof articles)[number];
interface Props { article: Article }
const { article } = Astro.props;
const index = articles.findIndex((item) => item.slug === article.slug);
const related = [1, 2].map((offset) => articles[(index + offset) % articles.length]).filter(Boolean) as Article[];
---

<article class="article-page">
  <div class="article-shell shell">
    <p class="breadcrumb article-breadcrumb"><a href="/">Home</a><span>/</span><a href="/blog">Resources</a><span>/</span><span class="breadcrumb-title">{article.title}</span></p>
    <header class="article-header">
      <h1>{article.title}</h1>
      <div class="article-meta"><span>{article.category}</span><time datetime={article.dateISO}>{article.date}</time></div>
      <img src={article.image} width="1760" height="1100" decoding="async" alt={article.imageAlt} />
      <p class="article-image-caption">Real LodgeOps staff screen with fictional sample lodge data.</p>
    </header>
    <div class="article-body">
      {article.blocks.map((block) => {
        if (block.type === "heading") return <h2>{block.text}</h2>;
        return <p>{block.text}</p>;
      })}
    </div>
  </div>
  <section class="related-posts section-pad">
    <div class="shell">
      <div class="related-heading"><h2>Keep Exploring</h2><p>See more real LodgeOps workflows and the people and resources they connect.</p></div>
      <div class="blog-grid related-grid">{related.map((item) => <BlogCard article={item} />)}</div>
    </div>
  </section>
</article>

<style>
  .article-header > img {
    aspect-ratio: 16 / 10;
    object-fit: contain;
    background: #edf1f4;
  }
  .article-image-caption {
    margin-top: 12px;
    color: #5d656b;
    font-size: 14px;
    line-height: 1.45;
  }
</style>
