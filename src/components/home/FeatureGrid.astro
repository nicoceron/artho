---
import SectionHeader from "../SectionHeader.astro";
import FeatureCard from './FeatureCard.astro';
import { featureCards } from '../../data/malvavisco';
---

<section class="feature-grid-section section-pad">
  <div class="shell">
    <div class="feature-grid">
      <div class="feature-top">
        <div class="feature-overview">
          <SectionHeader align="left" eyebrow="The workspace" title="All the moving parts, connected" description="Follow the booking from room plan to daily work, kitchen order and final balance." />
          <FeatureCard index={1} title={featureCards[0].title} description={featureCards[0].description} scene={featureCards[0].scene} />
        </div>
        <FeatureCard index={2} title={featureCards[1].title} description={featureCards[1].description} scene={featureCards[1].scene} />
      </div>
      <div class="feature-bottom">
        {featureCards.slice(2).map((feature, index) => <FeatureCard index={index + 3} title={feature.title} description={feature.description} scene={feature.scene} />)}
      </div>
    </div>
  </div>
</section>
