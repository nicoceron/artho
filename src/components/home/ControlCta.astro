---
import Badge from '../Badge.astro';
import UiIcon from '../UiIcon.astro';
import Button from "../Button.astro";

const teamRoles = [
  { name: "Reception", mark: "R" },
  { name: "Housekeeping", mark: "H" },
  { name: "Guides", mark: "G" },
  { name: "Kitchen", mark: "K" },
];
const teamTrack = Array.from({ length: 3 }, () => teamRoles).flat();
const sampleUpdates = [
  { mark: "R", message: "Two arrivals are on today's board", group: "Reception" },
  { mark: "H", message: "Room turnover is ready for review", group: "Housekeeping" },
  { mark: "G", message: "Guide and boat assignments are visible", group: "Activities" },
  { mark: "K", message: "Dietary notes are on the kitchen brief", group: "Kitchen" },
];
---

<section class="control-section section-pad">
  <div class="control-panel shell" data-control-scene>
    <div class="control-copy">
      <Badge label="A day at the lodge" />
      <h2>Give the whole team a clear plan</h2>
      <p>Bring arrivals, rooms, activities and kitchen work into the same daily view, with the booking behind every handoff.</p>
      <div class="control-points">
        <div><h3>Start with the stay</h3><p>Room plans, guests, services and charges are attached to the booking.</p></div>
        <div><h3>Keep work in step</h3><p>Role-specific tasks and preparation tickets make the next action visible.</p></div>
      </div>
      <Button href="/contact">Request a demo <span class="button-arrow">→</span></Button>
      <div class="micro-benefits"><span><i><UiIcon name="check" size={12} /></i>English and Spanish</span><span><i><UiIcon name="check" size={12} /></i>For the whole team</span></div>
    </div>
    <div class="control-visual">
      <div class="mobile-shell" data-live-balance data-control-visual data-control-visible="false" data-notification-open="false">
        <div class="mobile-head">
          <div class="mobile-user"><img src="/favicon.svg" alt="" /><span data-control-name>Sample workspace<b>Today at the lodge</b></span></div>
          <button class="notification-button" type="button" aria-label="Open sample updates" aria-expanded="false" aria-controls="control-notifications" data-control-notification-toggle>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg><i></i>
          </button>
        </div>
        <div class="balance-details">
          <p>Arrivals in the sample lodge</p>
          <strong data-count-value="2">0</strong>
          <div class="balance-date"><span>See what each role needs next</span></div>
        </div>
        <div class="quick-transfer">
          <div class="quick-transfer-head">
            <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h14M4 7l3-3M4 7l3 3M20 17H6m14 0-3-3m3 3-3 3" /></svg><b>One daily board</b></div>
            <span class="transfer-settings">Staff view</span>
          </div>
          <div class="transfer-divider"></div>
          <div class="transfer-contacts-head"><p>THE TEAM</p><div aria-hidden="true"><span>‹</span><span>›</span></div></div>
          <div class="transfer-viewport">
            <ul class="transfer-track" aria-label="Lodge staff roles">
              {teamTrack.map((role, index) => <li aria-hidden={index >= teamRoles.length ? "true" : undefined}><span class="team-initial" aria-hidden="true">{role.mark}</span><span>{role.name}</span></li>)}
            </ul>
          </div>
        </div>
        <section class="control-notifications" id="control-notifications" aria-label="Sample lodge updates" aria-hidden="true" data-control-notifications>
          <div class="control-notifications-head"><strong>Sample updates</strong><span>Daily board</span></div>
          <div class="control-notification-tabs"><span>Today</span><span>Based on a fictional lodge</span></div>
          <div class="control-notification-list">
            {sampleUpdates.map((update) => (
              <article class="control-notification-item">
                <span class="control-notification-mark" aria-hidden="true">{update.mark}</span>
                <div><p>{update.message}</p><small>{update.group}</small></div>
              </article>
            ))}
          </div>
        </section>
      </div>
    </div>
  </div>
</section>
