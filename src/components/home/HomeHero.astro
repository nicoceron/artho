---
import Button from "../Button.astro";
import CheckList from "../CheckList.astro";
import { malvaviscoBrand, productScreenshots } from "../../data/malvavisco";
---

<header class="home-hero">
  <div class="home-hero-panel shell" data-hero data-motion-variant="Desktop" data-reveal>
    <div class="hero-copy">
      <a class="announcement" href="/features"><span>Malvavisco</span> Explore the lodge workspace <b aria-hidden="true">↗</b></a>
      <h1>{malvaviscoBrand.headline}</h1>
      <p>{malvaviscoBrand.description}</p>
      <div class="button-row centered">
        <Button href="/contact">{malvaviscoBrand.primaryAction} <span class="button-arrow">→</span></Button>
        <Button href="/features" variant="outline">Explore the product</Button>
      </div>
      <CheckList items={[...malvaviscoBrand.highlights]} compact />
    </div>

    <div class="browser-mockup" data-hero-dashboard aria-label="Malvavisco sample lodge dashboard preview">
      <div class="browser-window">
        <div class="browser-bar" aria-hidden="true">
          <div class="browser-chrome-left">
            <div class="browser-dots"><span></span><span></span><span></span></div>
            <svg viewBox="0 0 20 20"><rect x="2.5" y="3" width="15" height="14" rx="1.5"/><path d="M8 3v14"/></svg>
            <svg class="browser-small-chevron" viewBox="0 0 12 12"><path d="m3 4 3 3 3-3"/></svg>
            <svg viewBox="0 0 20 20"><path d="m12 5-5 5 5 5"/></svg>
            <svg viewBox="0 0 20 20"><path d="m8 5 5 5-5 5"/></svg>
          </div>
          <span class="browser-address">Sample lodge · Dashboard <svg viewBox="0 0 20 20"><path d="M15.5 8A6 6 0 1 0 16 11"/><path d="M16 4v4h-4"/></svg></span>
          <div class="browser-chrome-right">
            <svg viewBox="0 0 20 20"><path d="M10 13V3m-3 3 3-3 3 3"/><path d="M5 9v7h10V9"/></svg>
            <svg viewBox="0 0 20 20"><path d="M10 4v12M4 10h12"/></svg>
            <svg viewBox="0 0 20 20"><rect x="5" y="3" width="11" height="11" rx="1"/><path d="M3 6v11h11"/></svg>
          </div>
        </div>
        <img src={productScreenshots.dashboard.src} alt={productScreenshots.dashboard.alt} width={productScreenshots.dashboard.width} height={productScreenshots.dashboard.height} />
      </div>
      <div class="hero-floating-card hero-floating-balance" data-hero-float="left" aria-label="Sample lodge arrivals overview"><span>Today at the lodge</span><strong>Arrivals and departures</strong><small>Keep the whole day in view</small></div>
      <div class="hero-floating-card hero-floating-expense" data-hero-float="right" aria-label="Sample lodge operations overview"><span>Operations board</span><strong>Rooms · Guides · Kitchen</strong><small>Work connected to each stay</small></div>
    </div>
    <p class="product-screen-note">{malvaviscoBrand.demoNote}</p>
  </div>
</header>
