---
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  ["Home", "/"],
  ["About", "/about"],
  ["Product", "/features"],
  ["For Lodges", "/pricing"],
] as const;

const active = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="site-header" data-header>
  <nav class="site-nav shell" aria-label="Primary navigation">
    <a class="brand" href="/" aria-label="Malvavisco home" style="width:auto;height:auto;white-space:nowrap">
      <span class="malvavisco-wordmark">malvavisco<span aria-hidden="true">.</span></span>
    </a>

    <div class="desktop-nav">
      {links.map(([label, href]) => (
        <a href={href} aria-current={pathname === href ? "page" : undefined} class:list={["nav-link", { active: active(href) }]}>
          {label}
        </a>
      ))}
      <div class="resource-menu">
        <button class:list={["nav-link", { active: pathname.startsWith("/blog") || pathname === "/faq" }]} type="button" aria-expanded="false" aria-controls="resource-menu" data-resource-toggle>
          Resources
        </button>
        <div class="resource-popover" id="resource-menu" data-resource-menu>
          <a href="/blog" aria-current={pathname === "/blog" ? "page" : undefined}>Guides</a>
          <a href="/faq" aria-current={pathname === "/faq" ? "page" : undefined}>Questions</a>
        </div>
      </div>
    </div>

    <div class="nav-actions">
      <a class="button button-dark compact" href="/contact">Request a Demo</a>
      <a class="button button-outline compact" href="/features">Explore LodgeOps</a>
    </div>

    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span></span><span></span><span></span>
    </button>
  </nav>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <div class="mobile-menu-inner shell">
      {links.map(([label, href]) => (
        <a href={href} aria-current={pathname === href ? "page" : undefined} class:list={["mobile-nav-link", { active: active(href) }]}>{label}</a>
      ))}
      <a href="/blog" aria-current={pathname === "/blog" ? "page" : undefined} class:list={["mobile-nav-link", { active: pathname.startsWith("/blog") }]}>Guides</a>
      <a href="/faq" aria-current={pathname === "/faq" ? "page" : undefined} class:list={["mobile-nav-link", { active: pathname === "/faq" }]}>Questions</a>
      <div class="mobile-menu-actions">
        <a class="button button-dark" href="/contact">Request a Demo</a>
        <a class="button button-outline" href="/features">Explore LodgeOps</a>
      </div>
    </div>
  </div>
</header>
<div class="site-header-spacer" aria-hidden="true"></div>

<style>
  .malvavisco-wordmark {
    display: inline-block;
    font-size: clamp(19px, 2vw, 24px);
    font-weight: 700;
    letter-spacing: -0.07em;
    line-height: 1.15;
  }

  .malvavisco-wordmark span { color: #65a30d; }
</style>
