---
import icons from '../data/badge-icons.json';
interface Props { label: string }
const { label } = Astro.props;
const icon = icons[label as keyof typeof icons];
---
<span class="eyebrow">
  {icon && <svg viewBox={icon.viewBox} width="14" height="14" aria-hidden="true" fill="currentColor">{icon.paths.map(d => <path d={d} />)}</svg>}
  {label}
</span>
