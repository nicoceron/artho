---
import UiIcon from './UiIcon.astro';
interface Props { variant?: 'signup' | 'card' }
const { variant = 'signup' } = Astro.props;
---
{variant === 'signup' ? (
  <div class="auth-card" inert aria-hidden="true">
    <div class="preview-card-header"><h3>Set up your lodge</h3><p>A sample setup of the places and services you offer.</p></div>
    <div class="preview-fields">
      <label>Lodge name<span class="preview-input"><UiIcon name="user" /><input type="text" value="Refugio del Bosque" readonly /></span></label>
      <label>Place<span class="preview-input"><UiIcon name="calendar" /><input type="text" value="Cabaña Lenga · 2 guests" readonly /></span></label>
      <label>Nightly rate<span class="preview-input"><UiIcon name="info" /><input type="text" value="Configured for this workspace" readonly /></span><small>Rates and capacity are set for each place.</small></label>
    </div>
    <div class="preview-agreement"><span class="preview-check" aria-hidden="true">✓</span><span>Rooms, services and the team’s resources belong to the same workspace.</span></div>
    <button type="button" tabindex="-1">Save place</button>
    <p class="preview-divider">Then add the team</p>
    <div class="auth-social"><span>Reception</span><span>Housekeeping</span></div>
    <p>Each role sees the work relevant to them.</p>
  </div>
) : (
  <div class="connect-card" inert aria-hidden="true">
    <div class="preview-card-header"><h3>Build a booking</h3><span aria-hidden="true">×</span><p>Keep the whole stay in one place.</p></div>
    <div class="preview-card-fields">
      <span class="preview-input"><UiIcon name="calendar" /><input aria-label="Arrival preview" value="Arrival · 12 October" readonly /></span>
      <div><span class="preview-input"><UiIcon name="calendar" /><input aria-label="Departure preview" value="15 October" readonly /></span><span class="preview-input"><UiIcon name="user" /><input aria-label="Guests preview" value="2 guests" readonly /></span></div>
      <input aria-label="Place preview" value="Cabaña Lenga" readonly />
    </div>
    <div class="preview-agreement"><span class="preview-check" aria-hidden="true">✓</span><span>Room capacity and overlapping stays are checked.</span></div>
    <button type="button" tabindex="-1">Review booking</button>
  </div>
)}
