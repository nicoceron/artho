---
import SectionHeader from "./SectionHeader.astro";
import AccountPreview from './AccountPreview.astro';
import MotionScene from './MotionScene.astro';
import { productScreenshots, workflowSteps } from "../data/malvavisco";
---

<section class="workflow-section section-pad">
  <div class="shell">
    <SectionHeader eyebrow="How it works" title="From reservation to departure" description="Configure the lodge, build the stay, plan the services and keep the daily team in step." />
    <div class="workflow-tabs" data-tabs data-reveal>
      <div class="workflow-list" role="tablist" aria-label="Setup steps" aria-orientation="vertical">
        {workflowSteps.map((step, index) => (
          <button id={`step-tab-${index + 1}`} role="tab" aria-selected={index === 0 ? "true" : "false"} aria-controls={`step-panel-${index + 1}`} tabindex={index === 0 ? 0 : -1} data-tab={step.panel} type="button">
            <span class="workflow-step-label"><span>Step</span><span class="step-number">{step.number}</span></span>
            <span class="workflow-step-copy"><b>{step.title}</b><small>{step.description}</small></span>
          </button>
        ))}
      </div>
      <div class="workflow-panels">
        <div id="step-panel-1" role="tabpanel" aria-labelledby="step-tab-1" tabindex="0" data-panel="signup" data-motion-panel class="workflow-panel signup-panel">
          <div class="workflow-preview-stage" role="img" aria-label="Illustration of lodge setup"><AccountPreview /></div>
        </div>
        <div id="step-panel-2" role="tabpanel" aria-labelledby="step-tab-2" tabindex="0" data-panel="card" data-motion-panel class="workflow-panel" hidden>
          <div class="workflow-preview-stage" role="img" aria-label="Illustration of a lodge booking"><AccountPreview variant="card" /></div>
        </div>
        <div id="step-panel-3" role="tabpanel" aria-labelledby="step-tab-3" tabindex="0" data-panel="dashboard" data-motion-panel class="workflow-panel" hidden>
          <div class="workflow-preview-stage"><div class="workflow-dashboard"><img src={productScreenshots.activities.src} alt={productScreenshots.activities.alt} width="1760" height="1100" loading="lazy" /></div></div>
        </div>
        <div id="step-panel-4" role="tabpanel" aria-labelledby="step-tab-4" data-panel="insights" data-motion-panel class="workflow-panel" hidden>
          <div class="workflow-preview-stage"><MotionScene scene="analytics" context="workflow" /></div>
        </div>
      </div>
    </div>
    <div class="workflow-mobile" data-reveal>
      <article class="workflow-mobile-step">
        <div class="workflow-mobile-head"><span class="workflow-step-label"><span class="step-number">01</span></span><span class="workflow-step-copy"><b>{workflowSteps[0].title}</b><small>{workflowSteps[0].description}</small></span></div>
        <div class="workflow-mobile-panel">
          <div class="workflow-preview-stage" role="img" aria-label="Illustration of lodge setup"><AccountPreview /></div>
        </div>
      </article>
      <article class="workflow-mobile-step">
        <div class="workflow-mobile-head"><span class="workflow-step-label"><span class="step-number">02</span></span><span class="workflow-step-copy"><b>{workflowSteps[1].title}</b><small>{workflowSteps[1].description}</small></span></div>
        <div class="workflow-mobile-panel"><div class="workflow-preview-stage" role="img" aria-label="Illustration of a lodge booking"><AccountPreview variant="card" /></div></div>
      </article>
      <article class="workflow-mobile-step">
        <div class="workflow-mobile-head"><span class="workflow-step-label"><span class="step-number">03</span></span><span class="workflow-step-copy"><b>{workflowSteps[2].title}</b><small>{workflowSteps[2].description}</small></span></div>
        <div class="workflow-mobile-panel"><div class="workflow-preview-stage"><div class="workflow-dashboard"><img src={productScreenshots.activities.src} alt={productScreenshots.activities.alt} width="1760" height="1100" loading="lazy" /></div></div></div>
      </article>
      <article class="workflow-mobile-step">
        <div class="workflow-mobile-head"><span class="workflow-step-label"><span class="step-number">04</span></span><span class="workflow-step-copy"><b>{workflowSteps[3].title}</b><small>{workflowSteps[3].description}</small></span></div>
        <div class="workflow-mobile-panel"><div class="workflow-preview-stage"><MotionScene scene="analytics" context="workflow" /></div></div>
      </article>
    </div>
  </div>
</section>
