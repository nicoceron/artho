---
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL as string | undefined;
const appUrl = import.meta.env.PUBLIC_APP_URL as string | undefined;
---

<footer class="site-footer">
  <div class="footer-inner shell">
    <div class="footer-main">
      <div class="footer-brand">
        <a href="/" aria-label="Malvavisco home" style="width:auto;height:auto;white-space:nowrap">
          <span class="malvavisco-wordmark">malvavisco<span aria-hidden="true">.</span></span>
        </a>
        <p>Makers of LodgeOps, calm administration software for lodges.</p>
        <p class="brand-note">Kinder stays, wilder days.</p>
      </div>

      <div class="footer-links">
        <div class="footer-column">
          <p class="footer-title">LodgeOps</p>
          <a href="/">Home</a>
          <a href="/features">Product</a>
          <a href="/pricing">For Lodges</a>
          <a href="/contact">Request a Demo</a>
          {appUrl && <a href={appUrl}>Staff Sign In</a>}
        </div>

        <div class="footer-column">
          <p class="footer-title">Resources</p>
          <a href="/blog">Guides</a>
          <a href="/faq">Questions</a>
          <a href="/about">About Malvavisco</a>
          <a href="/legal/terms-of-service">Website Terms</a>
          <a href="/legal/privacy-policy">Website Privacy</a>
        </div>

        <div class="footer-column contact-column">
          <p class="footer-title">Talk With Us</p>
          <p><a href="/contact">Tell us about your lodge</a></p>
          {contactEmail && <p><span>Email:</span> <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>}
        </div>
      </div>
    </div>
    <div class="footer-watermark" aria-hidden="true">malvavisco.</div>
  </div>
</footer>

<style>
  .malvavisco-wordmark {
    display: inline-block;
    color: #fff;
    font-size: 25px;
    font-weight: 700;
    letter-spacing: -0.07em;
    line-height: 1.2;
  }
  .malvavisco-wordmark span,
  .brand-note { color: #d1f44b !important; }
  .brand-note { margin-top: 16px; }
  .footer-watermark {
    width: 100%;
    height: auto;
    white-space: nowrap;
    overflow: hidden;
    color: #fff;
    font-size: clamp(70px, 11vw, 165px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.09em;
    opacity: .11;
  }
</style>
