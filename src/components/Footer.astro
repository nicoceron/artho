---
import UiIcon from './UiIcon.astro';
---
<footer class="site-footer">
  <div class="footer-inner shell">
    <div class="footer-main">
    <div class="footer-brand">
      <a href="/" aria-label="Artho home">
        <img src="/assets/framerusercontent.com/images/TjOTTTzduiVl6DqFs7S2fKH8qI8.svg" alt="Artho" />
      </a>
      <p>Your smart partner in modern<br />financial management.</p>
      <div class="socials" aria-label="Social media">
        <a href="https://linkedin.com" rel="noopener" aria-label="LinkedIn"><UiIcon name="linkedin" size={16} /></a>
        <a href="https://instagram.com" rel="noopener" aria-label="Instagram"><UiIcon name="instagram" size={16} /></a>
        <a href="https://x.com" rel="noopener" aria-label="X"><UiIcon name="x" size={16} /></a>
        <a href="https://youtube.com" rel="noopener" aria-label="YouTube"><UiIcon name="youtube" size={16} /></a>
      </div>
    </div>

    <div class="footer-links">
    <div class="footer-column">
      <p class="footer-title">Quick Links</p>
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/features">Features</a>
      <a href="/pricing">Pricing</a>
      <a href="/contact">Contact</a>
    </div>

    <div class="footer-column">
      <p class="footer-title">Resources</p>
      <a href="/blog">Blog</a>
      <a href="/faq">FAQ</a>
      <a href="/legal/terms-of-service">Terms of Service</a>
      <a href="/legal/privacy-policy">Privacy Policy</a>
    </div>

    <div class="footer-column contact-column">
      <p class="footer-title">Contact Us</p>
      <p><span>Email:</span> <a href="mailto:support@artho.com">support@artho.com</a></p>
      <p><span>Phone:</span> <a href="tel:18001234567">1-800-123-4567</a></p>
    </div>

    </div>
    </div>
    <img class="footer-watermark" src="/assets/framerusercontent.com/images/qiEBA010TcHKdsaEhXRtCVKgC6A.svg" alt="" aria-hidden="true" />
  </div>
</footer>
