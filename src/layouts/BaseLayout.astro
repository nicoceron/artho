---
import "../styles/global.css";
import "../styles/source-parity.css";
import "../styles/malvavisco.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  noFooter?: boolean;
  noIndex?: boolean;
}

const {
  title = "LodgeOps by Malvavisco — A calmer way to run your lodge",
  description = "LodgeOps by Malvavisco brings bookings, rooms, guides and gear, kitchen work, payments, and reports into one workspace for lodges.",
  noFooter = false,
  noIndex = false,
} = Astro.props;

const favicon = "/favicon.svg";
const socialImage = "/og.jpg";
const pagePath = Astro.url.pathname === "/" ? "/" : `${Astro.url.pathname.replace(/\/$/, "")}/`;
const canonical = Astro.site ? new URL(pagePath, Astro.site).href : undefined;
const socialImageUrl = Astro.site ? new URL(socialImage, Astro.site).href : socialImage;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Malvavisco" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="robots" content={noIndex ? "noindex" : "max-image-preview:large"} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    {!noFooter && <Footer />}
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
